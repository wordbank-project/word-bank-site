# Base URL of the word-bank-server feed (powers the live floating words + stats).
# Astro only exposes client env prefixed PUBLIC_. Leave unset to disable both
# (floating words fall back to the curated HERO_WORDS list; stats stays hidden).
PUBLIC_WORDS_API_URL=PUBLIC_WORDS_API_URL

# PostHog product analytics (marketing funnel: pageviews + download-click conversion).
# Runs cookieless (no cookies, no consent banner needed). Leave PUBLIC_POSTHOG_KEY
# unset to disable analytics entirely — the site builds and behaves exactly the same.
# Set the real key in the Netlify dashboard for production.
PUBLIC_POSTHOG_KEY=PUBLIC_POSTHOG_KEY

# Where the browser sends events. Defaults to "/ingest" — the same-origin reverse
# proxy declared in netlify.toml — so ad blockers don't drop events in production.
# Leave this UNSET in the Netlify dashboard so production gets the proxy.
#
# Locally it must point at the direct EU host: `npm run dev` is the Astro dev
# server, which does not apply netlify.toml rewrites, so /ingest would 404.
# Use `npx netlify dev` if you want to exercise the proxy itself.
PUBLIC_POSTHOG_HOST=PUBLIC_POSTHOG_HOST
