---
import "../styles/global.css";
// Display serif for headlines — self-hosted via Fontsource (subsetted woff2s
// with unicode-range, font-display: swap). Mapped to --font-display in
// global.css; body text stays on the system sans stack.
import "@fontsource-variable/fraunces";
import { DEFAULT_LANG, LANGS, LANG_META, getCopy, localeRoot, type Lang } from "../i18n";

interface Props {
    lang?: Lang;
    title?: string;
    description?: string;
}

const { lang = "en", title, description } = Astro.props;
const t = getCopy(lang);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

// Absolute URL for the social card; falls back gracefully when the site isn't
// configured with a deploy URL (Astro.site). The ?v= is a cache-buster — bump it
// whenever og-image.png changes so Discord/Slack/etc. re-fetch instead of serving
// a stale cached preview.
const ogImage = new URL("/og-image.png?v=2", Astro.site ?? Astro.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// One alternate per locale (from the i18n registry) — used for hreflang links
// and, as path-only roots, by the remembered-language redirect script below.
const alternates = LANGS.map((l) => ({
    lang: l,
    href: new URL(localeRoot(l), Astro.site ?? Astro.url).href,
}));
const defaultUrl = new URL(localeRoot(DEFAULT_LANG), Astro.site ?? Astro.url).href;
const localeRoots = Object.fromEntries(LANGS.map((l) => [l, localeRoot(l)]));

// Structured data (JSON-LD) so search engines show rich results: the app
// itself plus the FAQ (Google can render FAQ items directly in the listing).
// Built from the same localized copy the page renders, so it never drifts.
const appSchema = {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "Word Bank",
    operatingSystem: "Android",
    applicationCategory: "EducationalApplication",
    description: pageDescription,
    url: canonical,
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: t.faq.items.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
    })),
};
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <!-- Locale alternates so search engines pair every language version. -->
        {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
        <link rel="alternate" hreflang="x-default" href={defaultUrl} />
        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />

        <!-- Open Graph / Twitter card — brand-consistent link previews. -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:locale" content={LANG_META[lang].ogLocale} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={ogImage} />

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(appSchema)}
        />
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(faqSchema)}
        />

        <!-- Honour a remembered language choice before paint: if the visitor
             previously switched locale, send them to the matching page (no flash,
             no history entry). Only fires on an explicit mismatch, so shared
             links and crawlers are unaffected; the choice is written by the
             toggle in Header.astro. -->
        <script is:inline define:vars={{ pageLang: lang, localeRoots }}>
            (() => {
                try {
                    const saved = localStorage.getItem("lang");
                    if (saved && localeRoots[saved] && saved !== pageLang) {
                        window.location.replace(
                            localeRoots[saved] + window.location.hash,
                        );
                    }
                } catch {
                    /* localStorage blocked — stay on the current page. */
                }
            })();
        </script>

        <!-- Apply the saved theme before paint (no flash). Preference is
             "light" | "dark" | "system" (default system); we resolve it to a
             concrete light/dark on <html data-theme>. The toggle lives in the
             header (Header.astro). -->
        <script is:inline>
            (() => {
                try {
                    const pref = localStorage.getItem("theme") || "system";
                    const dark =
                        pref === "dark" ||
                        (pref === "system" &&
                            window.matchMedia("(prefers-color-scheme: dark)")
                                .matches);
                    document.documentElement.dataset.theme = dark
                        ? "dark"
                        : "light";
                } catch {
                    /* localStorage blocked — fall back to the CSS media query. */
                }
            })();
        </script>
    </head>
    <body>
        <slot />

        <!-- Scroll-reveal: fade sections up the first time they enter view
             (replaces the former useReveal React hook). -->
        <script>
            const reveal = () => {
                const els = document.querySelectorAll(".reveal");
                if (!("IntersectionObserver" in window)) {
                    els.forEach((el) => el.classList.add("revealed"));
                    return;
                }
                const observer = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("revealed");
                                observer.unobserve(entry.target);
                            }
                        }
                    },
                    { threshold: 0.15 },
                );
                els.forEach((el) => observer.observe(el));
            };
            reveal();
        </script>
    </body>
</html>
