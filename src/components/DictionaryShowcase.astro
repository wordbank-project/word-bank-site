---
import Section from "./Section.astro";
import { getCopy, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang);

// The word demoed in the card. English, looked up at build time from the free
// dictionary API (same source the app uses for English) and baked into the
// static page. Change this to feature a different word — but then also update
// the Sentence/Notes below, which are written for "flourish".
const WORD = "flourish";

// Example word the "try it" form looks up when submitted with an empty input.
// The placeholder copy (tryPlaceholder in i18n/{en,nl}.ts) mentions this word —
// keep them in sync if you change it.
const TRY_WORD = "petrichor";

type Item = { partOfSpeech: string; definition: string };

// Used if the API is unreachable at build time, so the page always renders.
const FALLBACK = {
    word: "flourish",
    phonetic: "/ˈflʌ.ɹɪʃ/",
    items: [
        {
            partOfSpeech: "noun",
            definition: "A dramatic gesture such as the waving of a flag.",
        },
        {
            partOfSpeech: "noun",
            definition:
                "A ceremonious passage such as a fanfare; an ornamental embellishment.",
        },
        { partOfSpeech: "verb", definition: "To thrive or grow well." },
        { partOfSpeech: "verb", definition: "To prosper or fare well." },
        {
            partOfSpeech: "verb",
            definition: "To make bold, sweeping movements with.",
        },
    ] as Item[],
};

// Map a part of speech to the colour-coded utility (mirrors the app's POS_COLORS;
// duplicated in the client script for the live recolour on select).
function posClass(pos: string): string {
    const p = pos.toLowerCase();
    if (p.startsWith("noun")) return "text-pos-noun";
    if (p.startsWith("verb")) return "text-pos-verb";
    if (p.startsWith("adject") || p === "adj") return "text-pos-adjective";
    if (p.startsWith("adverb") || p === "adv") return "text-pos-adverb";
    return "text-accent";
}

// Build-time lookup, mirroring the app's English path (words-api.ts → fetchEnglish).
let word = FALLBACK.word;
let phonetic = FALLBACK.phonetic;
let items: Item[] = FALLBACK.items;
try {
    const res = await fetch(
        `https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(WORD)}`,
    );
    if (res.ok) {
        const data = await res.json();
        const flat: Item[] = [];
        for (const entry of data ?? []) {
            for (const meaning of entry.meanings ?? []) {
                for (const def of meaning.definitions ?? []) {
                    if (def?.definition) {
                        flat.push({
                            partOfSpeech: (
                                meaning.partOfSpeech ?? ""
                            ).toLowerCase(),
                            definition: def.definition,
                        });
                    }
                }
            }
        }
        const seen = new Set<string>();
        const unique = flat
            .filter((it) => {
                const id = `${it.partOfSpeech}|${it.definition}`;
                if (seen.has(id)) return false;
                seen.add(id);
                return true;
            })
            .slice(0, 12);
        if (unique.length > 0) {
            items = unique;
            phonetic =
                data.find((e: { phonetic?: string }) => e.phonetic)?.phonetic ??
                "";
            word = data[0]?.word ?? WORD;
        }
    }
} catch {
    // Network unavailable at build — keep the FALLBACK above.
}

// Group definitions by part of speech (in order); each row keeps its global
// index into `items` so a selection maps back correctly.
const groups: { pos: string; rows: { index: number; definition: string }[] }[] =
    [];
items.forEach((it, index) => {
    let group = groups.find((g) => g.pos === it.partOfSpeech);
    if (!group) {
        group = { pos: it.partOfSpeech, rows: [] };
        groups.push(group);
    }
    group.rows.push({ index, definition: it.definition });
});

const posLabelClass = `mt-0.5 mb-2 inline-block text-[0.85rem] italic ${posClass(items[0].partOfSpeech)}`;
---

<Section id="dictionary">
    <div class="grid grid-cols-2 items-center gap-12 max-[720px]:grid-cols-1">
        <div>
            <h2 class="text-left max-[720px]:text-center">
                {t.dictionary.heading}
            </h2>
            {
                t.dictionary.paragraphs.map((p) => (
                    <p class="text-ink-soft">{p}</p>
                ))
            }
            <div
                class="mt-8 flex flex-wrap gap-2.5 gap-y-2"
                aria-label={t.dictionary.chipsAria}
            >
                <span
                    class="whitespace-nowrap rounded-full border border-accent bg-accent-soft px-3.5 py-1.25 text-[0.85rem] font-semibold text-accent"
                    >{t.dictionary.chips.english}</span
                >
                <span
                    class="whitespace-nowrap rounded-full border border-accent bg-accent-soft px-3.5 py-1.25 text-[0.85rem] font-semibold text-accent"
                    >{t.dictionary.chips.dutch}</span
                >
                <span
                    class="whitespace-nowrap rounded-full border border-line px-3.5 py-1.25 text-[0.85rem] font-semibold text-ink-muted"
                    >{t.dictionary.chips.more}</span
                >
            </div>
        </div>

        <div
            class="w-full max-w-105 justify-self-center rounded-[14px] border border-line bg-card p-6.5 shadow-(--shadow)"
        >
            <form
                data-dict-try
                data-example-word={TRY_WORD}
                data-msg-loading={t.dictionary.tryLoading}
                data-msg-error={t.dictionary.tryError}
                data-msg-notfound-pre={t.dictionary.tryNotFoundPre}
                data-msg-notfound-post={t.dictionary.tryNotFoundPost}
                class="mb-4 border-b border-line pb-4"
            >
                <label
                    for="dict-try-input"
                    class="mb-1.5 block text-[0.7rem] font-bold uppercase tracking-[0.06em] text-ink-muted"
                    >{t.dictionary.tryLabel}</label
                >
                <div class="flex gap-2">
                    <input
                        id="dict-try-input"
                        type="search"
                        maxlength="40"
                        autocomplete="off"
                        autocapitalize="none"
                        spellcheck="false"
                        placeholder={t.dictionary.tryPlaceholder}
                        class="min-w-0 flex-1 rounded-[10px] border border-line bg-surface-soft px-3 py-2 text-[0.95rem] text-ink placeholder:text-ink-muted"
                    />
                    <button
                        type="submit"
                        class="button button-small disabled:opacity-60"
                    >
                        {t.dictionary.tryButton}
                    </button>
                </div>
                <p
                    data-dict-status
                    role="status"
                    hidden
                    class="mt-2 mb-0 text-[0.85rem] text-ink-muted"
                >
                </p>
            </form>
            <div class="flex flex-wrap items-baseline gap-3">
                <span data-dict-word class="font-display text-[1.4rem] font-bold"
                    >{word}</span
                >
                <span
                    data-dict-phonetic
                    class="font-mono text-[0.9rem] text-ink-muted"
                    hidden={!phonetic}
                >
                    {phonetic}
                </span>
            </div>
            <span id="dict-pos" class={posLabelClass}
                >{items[0].partOfSpeech}</span
            >
            <p id="dict-definition" class="text-[0.95rem] text-ink-soft">
                {items[0].definition}
            </p>
            {
                items.length > 1 && (
                    <button
                        id="dict-open"
                        type="button"
                        class="mt-2 inline-block cursor-pointer text-[0.8rem] font-semibold text-accent transition-colors hover:saturate-200"
                        aria-haspopup="dialog"
                        aria-label={`${t.dictionary.chooseOtherAriaPre}${word}`}
                        data-aria-pre={t.dictionary.chooseOtherAriaPre}
                    >
                        {t.dictionary.chooseOther} (<span data-dict-count
                            >{items.length}</span
                        >) ›
                    </button>
                )
            }
            <div class="mt-2.5 border-t border-line pt-2.5" data-dict-example>
                <span
                    class="text-[0.7rem] font-bold uppercase tracking-[0.06em] text-ink-muted"
                    >{t.dictionary.sentenceLabel}</span
                >
                <p class="mt-0.5 mb-0 text-[0.9rem] text-ink-soft">
                    “{t.dictionary.demoSentence}”
                </p>
            </div>
            <div class="mt-2.5 border-t border-line pt-2.5" data-dict-example>
                <span
                    class="text-[0.7rem] font-bold uppercase tracking-[0.06em] text-ink-muted"
                    >{t.dictionary.notesLabel}</span
                >
                <p
                    class="mt-0.5 mb-0 text-[0.9rem] text-ink-soft"
                    set:html={t.dictionary.demoNotesHtml}
                />
            </div>
            <!-- Swapped in for the two blocks above after a live lookup — the
                 baked-in Sentence/Notes are written for the original demo word. -->
            <div class="mt-2.5 border-t border-line pt-2.5" data-dict-hint hidden>
                <p class="mt-0.5 mb-0 text-[0.9rem] italic text-ink-muted">
                    {t.dictionary.tryHint}
                </p>
            </div>
        </div>
    </div>
</Section>

{
    items.length > 1 && (
        <div
            id="dict-modal"
            class="fixed inset-0 z-50 hidden items-end justify-center"
            aria-hidden="true"
        >
            <div
                data-dict-backdrop
                class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-200"
            />
            <div
                data-dict-panel
                role="dialog"
                aria-modal="true"
                aria-label={t.dictionary.dialogAria}
                class="relative flex max-h-[70%] w-full max-w-[480px] translate-y-full flex-col overflow-hidden rounded-t-[16px] border border-line bg-surface shadow-(--shadow) transition-transform duration-250"
            >
                <div class="flex-1 overflow-y-auto" data-dict-list>
                    {groups.map((g) => (
                        <Fragment>
                            <div
                                data-dict-poshead
                                data-pos={g.pos}
                                class:list={[
                                    "px-4 pt-3.5 pb-1 text-[0.7rem] font-bold uppercase tracking-[0.06em]",
                                    posClass(g.pos),
                                ]}
                            >
                                {g.pos}
                            </div>
                            {g.rows.map((r) => (
                                <button
                                    type="button"
                                    data-dict-row
                                    data-index={r.index}
                                    data-pos={g.pos}
                                    class:list={[
                                        "flex w-full items-start gap-2 border-t border-line px-4 py-3 text-left",
                                        r.index === 0 ? "bg-card" : "",
                                    ]}
                                >
                                    <span
                                        class:list={[
                                            "dict-def-text flex-1 text-[0.95rem] leading-5",
                                            r.index === 0
                                                ? "font-semibold text-accent"
                                                : "text-ink",
                                        ]}
                                    >
                                        {r.definition}
                                    </span>
                                    <span
                                        class="dict-check text-[0.9rem] font-bold text-accent"
                                        hidden={r.index !== 0}
                                    >
                                        ✓
                                    </span>
                                </button>
                            ))}
                        </Fragment>
                    ))}
                    <p
                        data-dict-empty
                        class="hidden p-6 text-center text-[0.9rem] text-ink-muted"
                    >
                        {t.dictionary.emptyPre}
                        <span data-dict-query />
                        {t.dictionary.emptyPost}
                    </p>
                </div>

                <div class="flex items-center justify-between gap-3 px-4 pb-2 pt-4">
                    <span
                        class="truncate text-[1rem] font-bold text-ink"
                        data-dict-title
                        data-pre={t.dictionary.definitionsForPre}
                    >
                        {t.dictionary.definitionsForPre}
                        {word}
                    </span>
                    <button
                        data-dict-close
                        type="button"
                        class="cursor-pointer text-[1.1rem] leading-none text-ink-muted hover:text-ink"
                        aria-label={t.dictionary.close}
                    >
                        ✕
                    </button>
                </div>

                <input
                    data-dict-search
                    type="text"
                    placeholder={t.dictionary.searchPlaceholder}
                    aria-label={t.dictionary.searchPlaceholder}
                    class="mx-4 mb-4 rounded-lg border border-line bg-surface-soft px-3 py-3 text-[0.95rem] text-ink placeholder:text-ink-muted"
                />
            </div>
        </div>
    )
}

<script>
    import { backDismiss } from "../lib/back-dismiss";

    type Item = { pos: string; definition: string };

    const modal = document.getElementById("dict-modal");
    const openBtn = document.getElementById("dict-open");
    const definitionEl = document.getElementById("dict-definition");
    const posEl = document.getElementById("dict-pos");

    if (modal && openBtn && definitionEl && posEl) {
        const panel = modal.querySelector<HTMLElement>("[data-dict-panel]")!;
        const backdrop = modal.querySelector<HTMLElement>(
            "[data-dict-backdrop]",
        )!;
        const listEl = modal.querySelector<HTMLElement>("[data-dict-list]")!;
        // `let` — both are rebuilt when a visitor looks up a new word.
        let rows = Array.from(
            modal.querySelectorAll<HTMLButtonElement>("[data-dict-row]"),
        );
        let heads = Array.from(
            modal.querySelectorAll<HTMLElement>("[data-dict-poshead]"),
        );
        const empty = modal.querySelector<HTMLElement>("[data-dict-empty]");
        const queryOut = modal.querySelector<HTMLElement>("[data-dict-query]");
        const search =
            modal.querySelector<HTMLInputElement>("[data-dict-search]");
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const posClass = (pos: string): string => {
            const p = pos.toLowerCase();
            if (p.startsWith("noun")) return "text-pos-noun";
            if (p.startsWith("verb")) return "text-pos-verb";
            if (p.startsWith("adject") || p === "adj")
                return "text-pos-adjective";
            if (p.startsWith("adverb") || p === "adv") return "text-pos-adverb";
            return "text-accent";
        };

        // Filter rows by text / part of speech, and hide a POS header when none of
        // its rows are visible.
        const applyFilter = () => {
            const q = (search?.value ?? "").trim().toLowerCase();
            rows.forEach((row) => {
                const text =
                    row
                        .querySelector(".dict-def-text")
                        ?.textContent?.toLowerCase() ?? "";
                const pos = (row.getAttribute("data-pos") ?? "").toLowerCase();
                row.toggleAttribute(
                    "hidden",
                    !(!q || text.includes(q) || pos.includes(q)),
                );
            });
            let anyVisible = false;
            heads.forEach((head) => {
                const pos = head.getAttribute("data-pos");
                const hasVisible = rows.some(
                    (r) =>
                        r.getAttribute("data-pos") === pos &&
                        !r.hasAttribute("hidden"),
                );
                head.toggleAttribute("hidden", !hasVisible);
                if (hasVisible) anyVisible = true;
            });
            empty?.classList.toggle("hidden", anyVisible);
            if (queryOut) queryOut.textContent = search?.value ?? "";
        };

        const close = () => {
            backdrop.classList.add("opacity-0");
            panel.classList.add("translate-y-full");
            modal.setAttribute("aria-hidden", "true");
            const hide = () => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
            };
            if (reduceMotion) hide();
            else setTimeout(hide, 250);
            // Reset the search so the sheet reopens fresh (matches the app).
            if (search) search.value = "";
            applyFilter();
        };

        // Let the phone/browser Back button close the modal instead of leaving the site.
        const { pushOnOpen, requestClose } = backDismiss({
            key: "dictOpen",
            isOpen: () => !modal.classList.contains("hidden"),
            close,
        });

        const open = () => {
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            modal.setAttribute("aria-hidden", "false");
            requestAnimationFrame(() => {
                backdrop.classList.remove("opacity-0");
                panel.classList.remove("translate-y-full");
            });
            panel.focus?.();
            pushOnOpen();
        };

        const setSelected = (index: number) => {
            const chosen = rows.find(
                (r) => Number(r.getAttribute("data-index")) === index,
            );
            if (!chosen) return;
            definitionEl.textContent =
                chosen.querySelector(".dict-def-text")?.textContent ?? "";
            const pos = chosen.getAttribute("data-pos") ?? "";
            posEl.textContent = pos;
            posEl.className = `mt-0.5 mb-2 inline-block text-[0.85rem] italic ${posClass(pos)}`;
            rows.forEach((row) => {
                const active = Number(row.getAttribute("data-index")) === index;
                row.classList.toggle("bg-card", active);
                row.querySelector(".dict-def-text")?.classList.toggle(
                    "font-semibold",
                    active,
                );
                row.querySelector(".dict-def-text")?.classList.toggle(
                    "text-accent",
                    active,
                );
                row.querySelector(".dict-def-text")?.classList.toggle(
                    "text-ink",
                    !active,
                );
                row.querySelector(".dict-check")?.toggleAttribute(
                    "hidden",
                    !active,
                );
            });
        };

        openBtn.addEventListener("click", open);
        modal
            .querySelector("[data-dict-close]")
            ?.addEventListener("click", requestClose);
        backdrop.addEventListener("click", requestClose);
        // Row clicks are delegated to the list: rows are replaced wholesale
        // when a visitor looks up a new word.
        listEl.addEventListener("click", (e) => {
            const row = (
                e.target as HTMLElement | null
            )?.closest<HTMLButtonElement>("[data-dict-row]");
            if (!row) return;
            setSelected(Number(row.getAttribute("data-index")));
            requestClose();
        });
        search?.addEventListener("input", applyFilter);
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && !modal.classList.contains("hidden"))
                requestClose();
        });

        // ---- Live lookup: type any English word, same API as the app's
        //      English path (and the build-time demo word above). ----
        const form = document.querySelector<HTMLFormElement>("[data-dict-try]");
        const input =
            document.querySelector<HTMLInputElement>("#dict-try-input");
        const status = document.querySelector<HTMLElement>(
            "[data-dict-status]",
        );
        const wordEl = document.querySelector<HTMLElement>("[data-dict-word]");
        const phoneticEl = document.querySelector<HTMLElement>(
            "[data-dict-phonetic]",
        );
        const countEl = document.querySelector<HTMLElement>(
            "[data-dict-count]",
        );
        const titleEl = modal.querySelector<HTMLElement>("[data-dict-title]");
        const examples = Array.from(
            document.querySelectorAll<HTMLElement>("[data-dict-example]"),
        );
        const hint = document.querySelector<HTMLElement>("[data-dict-hint]");

        if (form && input && wordEl) {
            const setStatus = (text: string) => {
                if (!status) return;
                status.textContent = text;
                status.hidden = !text;
            };

            const makeHead = (pos: string): HTMLElement => {
                const div = document.createElement("div");
                div.setAttribute("data-dict-poshead", "");
                div.setAttribute("data-pos", pos);
                div.className = `px-4 pt-3.5 pb-1 text-[0.7rem] font-bold uppercase tracking-[0.06em] ${posClass(pos)}`;
                div.textContent = pos;
                return div;
            };

            const makeRow = (
                index: number,
                pos: string,
                definition: string,
            ): HTMLButtonElement => {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.setAttribute("data-dict-row", "");
                btn.setAttribute("data-index", String(index));
                btn.setAttribute("data-pos", pos);
                btn.className =
                    "flex w-full items-start gap-2 border-t border-line px-4 py-3 text-left";
                const text = document.createElement("span");
                text.className =
                    "dict-def-text flex-1 text-[0.95rem] leading-5 text-ink";
                text.textContent = definition;
                const check = document.createElement("span");
                check.className =
                    "dict-check text-[0.9rem] font-bold text-accent";
                check.hidden = true;
                check.textContent = "✓";
                btn.append(text, check);
                return btn;
            };

            // Replace the sheet's rows, grouped by part of speech in order of
            // first appearance — mirrors the build-time grouping above.
            const renderRows = (items: Item[]) => {
                heads.forEach((h) => h.remove());
                rows.forEach((r) => r.remove());
                heads = [];
                rows = [];
                const groups: { pos: string; items: typeof rows }[] = [];
                items.forEach((it, index) => {
                    let group = groups.find((g) => g.pos === it.pos);
                    if (!group) {
                        group = { pos: it.pos, items: [] };
                        groups.push(group);
                        const head = makeHead(it.pos);
                        heads.push(head);
                        listEl.insertBefore(head, empty);
                    }
                    const row = makeRow(index, it.pos, it.definition);
                    group.items.push(row);
                    rows.push(row);
                });
                // Rows go after their group head; heads were inserted in
                // group order, so appending rows right after creation would
                // interleave groups — reinsert per group instead.
                for (const g of groups) {
                    const head = heads.find(
                        (h) => h.getAttribute("data-pos") === g.pos,
                    )!;
                    let anchor: ChildNode | null = head.nextSibling;
                    for (const row of g.items) {
                        listEl.insertBefore(row, anchor);
                        anchor = row.nextSibling;
                    }
                }
            };

            // Same flatten/dedupe/cap the build-time lookup applies.
            const parseEntries = (
                data: unknown,
            ): { word: string; phonetic: string; items: Item[] } => {
                const entries: any[] = Array.isArray(data) ? data : [];
                const flat: Item[] = [];
                for (const entry of entries) {
                    for (const meaning of entry?.meanings ?? []) {
                        for (const def of meaning?.definitions ?? []) {
                            if (def?.definition) {
                                flat.push({
                                    pos: String(
                                        meaning.partOfSpeech ?? "",
                                    ).toLowerCase(),
                                    definition: String(def.definition),
                                });
                            }
                        }
                    }
                }
                const seen = new Set<string>();
                const items = flat
                    .filter((it) => {
                        const id = `${it.pos}|${it.definition}`;
                        if (seen.has(id)) return false;
                        seen.add(id);
                        return true;
                    })
                    .slice(0, 12);
                return {
                    word: String(entries[0]?.word ?? ""),
                    phonetic: String(
                        entries.find((e) => e?.phonetic)?.phonetic ?? "",
                    ),
                    items,
                };
            };

            const showWord = (
                word: string,
                phonetic: string,
                items: Item[],
            ) => {
                wordEl.textContent = word;
                if (phoneticEl) {
                    phoneticEl.textContent = phonetic;
                    phoneticEl.hidden = !phonetic;
                }
                renderRows(items);
                setSelected(0);
                if (countEl) countEl.textContent = String(items.length);
                openBtn.hidden = items.length < 2;
                openBtn.setAttribute(
                    "aria-label",
                    `${openBtn.dataset.ariaPre ?? ""}${word}`,
                );
                if (titleEl)
                    titleEl.textContent = `${titleEl.dataset.pre ?? ""}${word}`;
                // The baked-in Sentence/Notes were written for the original
                // demo word — swap them for the "in the app you'd…" hint.
                examples.forEach((el) => (el.hidden = true));
                if (hint) hint.hidden = false;
                if (search) search.value = "";
                applyFilter();
            };

            let busy = false;
            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                // An empty submit looks up the placeholder example word.
                const q =
                    input.value.trim() || (form.dataset.exampleWord ?? "");
                if (!q || busy) return;
                busy = true;
                const submit = form.querySelector<HTMLButtonElement>(
                    'button[type="submit"]',
                );
                if (submit) submit.disabled = true;
                setStatus(form.dataset.msgLoading ?? "…");
                try {
                    const res = await fetch(
                        `https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(q)}`,
                    );
                    if (res.status === 404) {
                        setStatus(
                            `${form.dataset.msgNotfoundPre ?? ""}${q}${form.dataset.msgNotfoundPost ?? ""}`,
                        );
                        return;
                    }
                    if (!res.ok) {
                        setStatus(form.dataset.msgError ?? "");
                        return;
                    }
                    const parsed = parseEntries(await res.json());
                    if (parsed.items.length === 0) {
                        setStatus(
                            `${form.dataset.msgNotfoundPre ?? ""}${q}${form.dataset.msgNotfoundPost ?? ""}`,
                        );
                        return;
                    }
                    showWord(parsed.word || q, parsed.phonetic, parsed.items);
                    setStatus("");
                } catch {
                    setStatus(form.dataset.msgError ?? "");
                } finally {
                    busy = false;
                    if (submit) submit.disabled = false;
                }
            });
        }
    }
</script>
