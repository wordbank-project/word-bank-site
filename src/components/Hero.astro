---
import { getCopy, type Lang } from "../i18n";
import FloatingWords from "./FloatingWords.astro";
import PhoneMockup from "./PhoneMockup.astro";
import WordWall from "./WordWall.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang);

// The badges line ("Free during beta · No account · Works offline") becomes
// individual check-marked chips — split on the separator the copy already uses.
const badges = t.hero.badges.split("·").map((b) => b.trim());
---

<section id="top" class="hero">
    <FloatingWords />
    <div
        class="relative z-1 mx-auto grid max-w-270 grid-cols-[1.15fr_0.85fr] items-center gap-12 px-6 max-[720px]:grid-cols-1"
    >
        <div>
            <h1 class="text-[clamp(2rem,5vw,3.1rem)]">
                {t.hero.headlinePre}<span class="text-gradient-accent"
                    ><a class="hover:saturate-200" href="#dictionary"
                        >{t.hero.headlineLink}</a
                    >{t.hero.headlinePost}</span
                >
            </h1>
            <p class="max-w-130 text-[1.1rem] text-ink-soft">
                <span class="italic">Word Bank</span>{t.hero.sub}
            </p>
            <ul class="m-0 mt-4 flex list-none flex-wrap gap-2 p-0">
                {
                    badges.map((badge) => (
                        <li class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-soft px-3 py-1 text-[0.8rem] font-medium text-ink-soft">
                            <svg
                                class="h-3.5 w-3.5 text-accent"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="m4 12.5 5 5L20 6.5" />
                            </svg>
                            {badge}
                        </li>
                    ))
                }
            </ul>
            <div id="download" class="my-7 flex flex-wrap gap-3.5">
                <a class="button" href="#">
                    {t.hero.downloadAndroid} <small>{t.hero.androidBeta}</small>
                </a>
                <span class="button button-ghost" aria-disabled="true"
                    >{t.hero.iosSoon}</span
                >
                <span class="button button-ghost" aria-disabled="true"
                    >{t.hero.webSoon}</span
                >
            </div>
            <div class="mt-5">
                <WordWall lang={lang} />
            </div>
        </div>
        <PhoneMockup lang={lang} />
    </div>
</section>
