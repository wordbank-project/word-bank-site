---
import Logo from "./Logo.astro";
import { getCopy, localeRoot, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-7">
    <div
        class="mx-auto flex max-w-270 flex-wrap items-center justify-between gap-3 px-6 text-ink-soft"
    >
        <span class="inline-flex items-center gap-2">
            <Logo size={24} /> Word Bank © {year}
        </span>
        <span class="inline-flex items-center flex-wrap gap-4">
            <span class="text-[0.9rem] text-ink-muted">{t.footer.tagline}</span>
            <a
                href={localeRoot(lang) + "support"}
                data-ph-event="support_click"
                data-ph-location="footer"
                class="inline-flex items-center gap-1.5 text-[0.9rem] font-semibold text-ink-soft transition-colors hover:text-accent"
            >
                <svg
                    class="h-4.5 w-4.5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                    ></path>
                </svg>
                {t.footer.support}
            </a>
        </span>
    </div>
</footer>
