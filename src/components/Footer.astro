---
import Logo from "./Logo.astro";
import { REPO_URL } from "../content";
import { getCopy, localeRoot, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-7">
    <div
        class="mx-auto flex max-w-270 flex-wrap items-center justify-between gap-3 px-6 text-ink-soft"
    >
        <span class="inline-flex items-center gap-2">
            <Logo size={24} /> Word Bank © {year}
        </span>
        <span class="inline-flex items-center gap-4">
            <span class="text-[0.9rem] text-ink-muted">{t.footer.tagline}</span>
            <a
                href={REPO_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-ph-event="repo_click"
                data-ph-location="footer"
                class="inline-flex items-center gap-1.5 text-[0.9rem] font-semibold text-ink-soft transition-colors hover:text-accent"
            >
                <svg
                    class="h-4.5 w-4.5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.85.09-.66.35-1.12.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
                    ></path>
                </svg>
                GitHub
            </a>
            <a
                href={localeRoot(lang) + "support"}
                data-ph-event="support_click"
                data-ph-location="footer"
                class="inline-flex items-center gap-1.5 text-[0.9rem] font-semibold text-ink-soft transition-colors hover:text-accent"
            >
                <svg
                    class="h-4.5 w-4.5"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                    ></path>
                </svg>
                {t.footer.support}
            </a>
        </span>
    </div>
</footer>
