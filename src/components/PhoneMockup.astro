---
import { MOCK_BOOKS, PHONE_DEMO } from "../content";
import type { ReadStatus } from "../content";
import { getCopy, type Lang } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang);
const demo = t.phone.demo;
const book = MOCK_BOOKS[0]; // 1984 — the book the animated story searches and opens

const FILTERS: { value: ReadStatus | "all"; label: string }[] = [
    { value: "all", label: t.phone.filters.all },
    { value: "want", label: t.phone.filters.want },
    { value: "reading", label: t.phone.filters.reading },
    { value: "read", label: t.phone.filters.read },
];
---

{
    /* Animated story: search 1984 → open it → type "doublethink" → definition
    card → sentence + note → the word is saved on the book page → over to the
    Read List, where the count updates 12 → 13. Plays once on first view; ↻
    replays. The Read List view is the server-rendered default: no-JS users see
    that static mockup, while prefers-reduced-motion users still get the whole
    walkthrough, just with instant, motion-free transitions. */
}
<div class="phone-wrap">
    <div class="phone" role="group" aria-label={t.phone.aria}>
        <div class="phone-screen">
            <div class="phone-stage" data-stage>
                {/* ---- View 1: Search ---- */}
                <section class="phone-view" data-view="search">
                    <div class="phone-header">{t.phone.tabs.search}</div>
                    <div class="phone-field mx-2.5" data-field="query">
                        <span data-type="query" data-text={PHONE_DEMO.query}
                        ></span>
                        <span class="phone-field-ph"
                            >{demo.searchPlaceholder}</span
                        >
                    </div>
                    <div class="phone-list">
                        {
                            PHONE_DEMO.results.map((r, i) => (
                                <div
                                    class="phone-row phone-anim"
                                    data-result={i === 0 ? "target" : ""}
                                >
                                    <span
                                        class="phone-cover"
                                        style={`background-color:${r.coverColor}`}
                                    />
                                    <span class="phone-row-info">
                                        <span class="phone-row-title">
                                            {r.title}
                                        </span>
                                        <span class="phone-row-author">
                                            {r.author}
                                        </span>
                                    </span>
                                </div>
                            ))
                        }
                    </div>
                </section>

                {/* ---- View 2: Book (1984) ---- */}
                <section class="phone-view" data-view="book">
                    <div class="phone-row phone-book-head">
                        <span
                            class="phone-cover"
                            style={`background-color:${book.coverColor}`}
                        ></span>
                        <span class="phone-row-info">
                            <span class="phone-row-title">{book.title}</span>
                            <span class="phone-row-author">{book.author}</span>
                            <span class="phone-status phone-status-reading"
                                >{t.statusLabels.reading}</span
                            >
                        </span>
                        <span class="phone-badge">
                            <span class="phone-badge-count"
                                >{book.wordCount}</span
                            >
                            <span class="phone-badge-label"
                                >{t.phone.wordPlural}</span
                            >
                        </span>
                    </div>
                    <div class="phone-addrow">
                        <div class="phone-field" data-field="word">
                            <span data-type="word" data-text={PHONE_DEMO.word}
                            ></span>
                            <span class="phone-field-ph"
                                >{demo.addPlaceholder}</span
                            >
                        </div>
                        <button
                            type="button"
                            class="phone-add-btn"
                            data-add-btn
                            tabindex="-1">{demo.addButton}</button
                        >
                    </div>
                    <div class="phone-word-card phone-anim" data-word-card>
                        <span class="phone-word-head">
                            <span class="phone-word-title"
                                >{PHONE_DEMO.word}</span
                            >
                            <span class="phone-word-ipa">{PHONE_DEMO.ipa}</span>
                        </span>
                        <span class="phone-word-pos text-pos-noun"
                            >{demo.pos}</span
                        >
                        <span class="phone-word-def">{demo.definition}</span>
                        <span class="phone-word-label"
                            >{demo.sentenceLabel}</span
                        >
                        <span
                            class="phone-field phone-field-inline"
                            data-field="sentence"
                        >
                            <span data-type="sentence" data-text={demo.sentence}
                            ></span>
                        </span>
                        <span class="phone-word-label">{demo.noteLabel}</span>
                        <span
                            class="phone-field phone-field-inline"
                            data-field="note"
                        >
                            <span data-type="note" data-text={demo.note}></span>
                        </span>
                    </div>
                </section>

                {
                    /* ---- View 3: Words List — the added word + existing words, with
                     colour-coded part-of-speech filter chips the story taps. ---- */
                }
                <section class="phone-view" data-view="words">
                    <div class="phone-header">{t.phone.tabs.wordList}</div>

                    {
                        /* Decorative search bar — the app's Words List has one above the filters. */
                    }
                    <div class="phone-field mx-2.5 mt-1 mb-2">
                        <span class="phone-field-ph">{t.phone.wordSearch}</span>
                    </div>

                    <div class="phone-filters" data-word-filters>
                        <button
                            type="button"
                            data-word-filter="all"
                            aria-pressed="true"
                            class="phone-pill selected"
                            >{t.phone.filters.all}</button
                        >
                        <button
                            type="button"
                            data-word-filter="noun"
                            aria-pressed="false"
                            class="phone-pill text-pos-noun"
                            >{t.phone.wordPos.noun}</button
                        >
                        <button
                            type="button"
                            data-word-filter="verb"
                            aria-pressed="false"
                            class="phone-pill text-pos-verb"
                            >{t.phone.wordPos.verb}</button
                        >
                        <button
                            type="button"
                            data-word-filter="adjective"
                            aria-pressed="false"
                            class="phone-pill text-pos-adjective"
                            >{t.phone.wordPos.adjective}</button
                        >
                    </div>

                    <div class="phone-list">
                        <div
                            class="phone-word-row phone-anim"
                            data-new-word
                            data-word-row
                            data-word-pos={PHONE_DEMO.pos}
                        >
                            <span class="phone-word-title"
                                >{PHONE_DEMO.word}</span
                            >
                            <span class="phone-word-ipa">{PHONE_DEMO.ipa}</span>
                            <span
                                class={`phone-word-pos text-pos-${PHONE_DEMO.pos}`}
                                >{t.phone.wordPos[PHONE_DEMO.pos]}</span
                            >
                            <span class="phone-word-from">{book.title}</span>
                        </div>
                        {
                            PHONE_DEMO.existingWords.map((w) => (
                                <div
                                    class="phone-word-row"
                                    data-word-row
                                    data-word-pos={w.pos}
                                >
                                    <span class="phone-word-title">
                                        {w.word}
                                    </span>
                                    <span class="phone-word-ipa">{w.ipa}</span>
                                    <span
                                        class={`phone-word-pos text-pos-${w.pos}`}
                                    >
                                        {t.phone.wordPos[w.pos]}
                                    </span>
                                    <span class="phone-word-from">
                                        {book.title}
                                    </span>
                                </div>
                            ))
                        }
                    </div>
                </section>

                {
                    /* ---- View 4: Read List (the original static mockup; default) ---- */
                }
                <section class="phone-view is-active" data-view="readlist">
                    <div class="phone-header">{t.phone.readList}</div>

                    <div class="phone-filters" data-phone-filters>
                        {
                            FILTERS.map(({ value, label }) => (
                                <button
                                    type="button"
                                    data-phone-filter={value}
                                    aria-pressed={value === "all"}
                                    class:list={[
                                        "phone-pill",
                                        { selected: value === "all" },
                                    ]}
                                >
                                    {label}
                                </button>
                            ))
                        }
                    </div>

                    <div class="phone-list">
                        {
                            MOCK_BOOKS.map((b, i) => (
                                <div class="phone-row" data-status={b.status}>
                                    <span
                                        class="phone-cover"
                                        style={`background-color:${b.coverColor}`}
                                    />
                                    <span class="phone-row-info">
                                        <span class="phone-row-title">
                                            {b.title}
                                        </span>
                                        <span class="phone-row-author">
                                            {b.author}
                                        </span>
                                        <span
                                            class={`phone-status phone-status-${b.status}`}
                                        >
                                            {t.statusLabels[b.status]}
                                        </span>
                                    </span>
                                    <span class="phone-badge">
                                        <span
                                            class="phone-badge-count"
                                            data-demo-badge={
                                                i === 0 ? "" : undefined
                                            }
                                        >
                                            {b.wordCount}
                                        </span>
                                        <span class="phone-badge-label">
                                            {b.wordCount === 1
                                                ? t.phone.wordSingular
                                                : t.phone.wordPlural}
                                        </span>
                                    </span>
                                </div>
                            ))
                        }
                    </div>
                </section>
            </div>

            {
                /* Shared tab bar — the story moves the active tab as it navigates. */
            }
            <div class="phone-tabbar" data-tabbar>
                <span data-tab="search">{t.phone.tabs.search}</span>
                <span class="active" data-tab="readlist"
                    >{t.phone.tabs.readList}</span
                >
                <span data-tab="words">{t.phone.tabs.wordList}</span>
                <span data-tab="more">{t.phone.tabs.more}</span>
            </div>
        </div>
    </div>

    <button
        type="button"
        class="phone-replay"
        data-replay
        hidden
    >
        ↻ {demo.replay}
    </button>
</div>

<script>
    // The status pills work like in the app: tap one to filter the book list.
    // (The stage's fixed height keeps the phone from shrinking when a filter
    // shows fewer books.)
    const filters = document.querySelector<HTMLElement>("[data-phone-filters]");
    if (filters) {
        const pills = Array.from(
            filters.querySelectorAll<HTMLButtonElement>("[data-phone-filter]"),
        );
        const rows = Array.from(
            document.querySelectorAll<HTMLElement>(".phone-row[data-status]"),
        );
        pills.forEach((pill) =>
            pill.addEventListener("click", () => {
                const value = pill.dataset.phoneFilter;
                pills.forEach((p) => {
                    const selected = p === pill;
                    p.classList.toggle("selected", selected);
                    p.setAttribute("aria-pressed", String(selected));
                });
                rows.forEach((row) =>
                    row.toggleAttribute(
                        "hidden",
                        value !== "all" && row.dataset.status !== value,
                    ),
                );
            }),
        );
    }
</script>

<script>
    // ---------------------------------------------------------------------
    // The mockup story: a pausable step-queue timeline. Plays once when the
    // phone first scrolls into view; pauses off-screen / on hidden tab;
    // ↻ resets and replays. Under prefers-reduced-motion the SAME walkthrough
    // still runs, but motion-free: view changes are instant cuts (CSS kills the
    // slide transitions) and text is filled in one beat instead of typed. Only
    // no-JS users see the plain server-rendered Read List.
    //
    // The replay button reports to PostHog imperatively (not via data-ph-event)
    // because its useful properties — which pass this is, whether playback was
    // interrupted — are only known at click time. See analytics.md.
    // ---------------------------------------------------------------------
    import { track } from "../lib/analytics";

    const wrap = document.querySelector<HTMLElement>(".phone-wrap");
    const stage = wrap?.querySelector<HTMLElement>("[data-stage]");
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    if (wrap && stage) {
        const ORDER = ["search", "book", "words", "readlist"] as const;
        // Which bottom tab is "active" while a view is showing.
        const TAB_FOR: Record<string, string> = {
            search: "search",
            book: "search",
            words: "words",
            readlist: "readlist",
        };
        const views = ORDER.map((name) =>
            stage.querySelector<HTMLElement>(`[data-view="${name}"]`)!,
        );
        const tabs = Array.from(
            document.querySelectorAll<HTMLElement>("[data-tabbar] [data-tab]"),
        );
        const replay = wrap.querySelector<HTMLButtonElement>("[data-replay]")!;
        const badge = wrap.querySelector<HTMLElement>("[data-demo-badge]");
        const baseCount = badge?.textContent?.trim() ?? "12";

        function setView(name: (typeof ORDER)[number]): void {
            const target = ORDER.indexOf(name);
            views.forEach((v, idx) => {
                v.classList.toggle("is-active", idx === target);
                v.classList.toggle("is-left", idx < target);
            });
            tabs.forEach((tab) =>
                tab.classList.toggle(
                    "active",
                    tab.dataset.tab === TAB_FOR[name],
                ),
            );
        }

        // --- Step queue ----------------------------------------------------
        type Step = { delay: number; run?: () => void };
        const steps: Step[] = [];
        const add = (delay: number, run?: () => void) =>
            steps.push({ delay, run });

        // Types `data-text` into a [data-type] span, one char per step, with a
        // caret while typing (`.is-typing` on the surrounding .phone-field also
        // hides its placeholder).
        function addTyping(field: HTMLElement, speed = 70, lead = 300): void {
            const span = field.querySelector<HTMLElement>("[data-type]")!;
            const text = span.dataset.text ?? "";
            if (reduceMotion) {
                // Motion-free: fill the field in a single beat, no caret/typing.
                add(lead, () => {
                    span.textContent = text;
                });
                return;
            }
            add(lead, () => field.classList.add("is-typing"));
            for (const ch of text) {
                add(speed, () => {
                    span.textContent = (span.textContent ?? "") + ch;
                });
            }
            add(250, () => field.classList.remove("is-typing"));
        }

        const q = <T extends HTMLElement>(sel: string) =>
            wrap.querySelector<T>(sel)!;
        const queryField = q('[data-field="query"]');
        const wordField = q('[data-field="word"]');
        const sentenceField = q('[data-field="sentence"]');
        const noteField = q('[data-field="note"]');
        const results = Array.from(
            wrap.querySelectorAll<HTMLElement>("[data-result]"),
        );
        const addBtn = q("[data-add-btn]");
        const wordCard = q("[data-word-card]");
        const newWordRow = q("[data-new-word]");
        const wordFilters = Array.from(
            wrap.querySelectorAll<HTMLElement>("[data-word-filter]"),
        );
        const wordRows = Array.from(
            wrap.querySelectorAll<HTMLElement>("[data-word-row]"),
        );

        // Tap a part-of-speech chip: mark it selected and collapse the rows that
        // don't match ("all" clears the filter). Drives the Words List filter demo.
        function selectWordFilter(pos: string): void {
            wordFilters.forEach((btn) => {
                const on = btn.dataset.wordFilter === pos;
                btn.classList.toggle("selected", on);
                btn.setAttribute("aria-pressed", String(on));
            });
            wordRows.forEach((row) => {
                const match = pos === "all" || row.dataset.wordPos === pos;
                row.classList.toggle("is-filtered-out", !match);
            });
        }

        // --- The story -------------------------------------------------------
        add(600, () => setView("search"));
        addTyping(queryField, 90, 700);
        results.forEach((row) => add(160, () => row.classList.add("is-shown")));
        add(650, () => results[0].classList.add("is-pressed"));
        add(350, () => setView("book"));
        addTyping(wordField, 70, 800);
        add(250, () => addBtn.classList.add("is-pressed"));
        add(300, () => {
            addBtn.classList.remove("is-pressed");
            wordCard.classList.add("is-shown");
        });
        addTyping(sentenceField, 45, 800);
        addTyping(noteField, 45, 500);
        add(400, () => wordCard.classList.add("is-saved"));
        add(900, () => setView("words"));
        add(450, () => newWordRow.classList.add("is-shown"));
        add(1100, () => selectWordFilter("noun")); // tap "Noun" — the verb/adj rows collapse
        add(1500, () => selectWordFilter("all")); // clear the filter before leaving
        add(500, () => setView("readlist"));
        add(550, () => {
            if (badge) {
                badge.textContent = String(Number(baseCount) + 1);
            }
        });
        add(600); // settle

        // --- Runner (play / pause / resume / reset) --------------------------
        let index = 0;
        let timer: number | null = null;
        let scheduledAt = 0;
        let remaining: number | null = null;
        let playing = false;
        let started = false;
        let finished = false;
        let inView = false;

        // Analytics counters, all per-pageview. `pauses` is cumulative: any
        // pause means the visitor was scrolled away or on another tab for part
        // of the story, so a replay is "I missed it" rather than "I liked it".
        let replays = 0;
        let pauses = 0;
        let completedAt = 0;

        function scheduleNext(delay: number): void {
            scheduledAt = Date.now();
            timer = window.setTimeout(() => {
                timer = null;
                steps[index].run?.();
                index += 1;
                if (index < steps.length) {
                    scheduleNext(steps[index].delay);
                } else {
                    playing = false;
                    finished = true;
                    replay.hidden = false;
                    completedAt = Date.now();
                    // The denominator for demo_replay_click: filter to
                    // replay_count = 0 for first, unprompted completions.
                    track("demo_complete", {
                        location: "hero",
                        replay_count: replays,
                        interrupted: pauses > 0,
                        reduced_motion: reduceMotion,
                    });
                }
            }, delay);
        }

        function play(): void {
            if (playing || finished || index >= steps.length) return;
            playing = true;
            scheduleNext(remaining ?? steps[index].delay);
            remaining = null;
        }

        function pause(): void {
            if (!playing) return;
            playing = false;
            pauses += 1;
            if (timer !== null) {
                clearTimeout(timer);
                timer = null;
                remaining = Math.max(
                    0,
                    steps[index].delay - (Date.now() - scheduledAt),
                );
            }
        }

        function reset(): void {
            pause();
            index = 0;
            remaining = null;
            finished = false;
            replay.hidden = true;
            wrap!
                .querySelectorAll<HTMLElement>("[data-type]")
                .forEach((s) => (s.textContent = ""));
            [queryField, wordField, sentenceField, noteField].forEach((f) =>
                f.classList.remove("is-typing"),
            );
            results.forEach((r) =>
                r.classList.remove("is-shown", "is-pressed"),
            );
            wordCard.classList.remove("is-shown", "is-saved");
            newWordRow.classList.remove("is-shown");
            selectWordFilter("all");
            if (badge) {
                badge.textContent = baseCount;
            }
            // Jump (not slide) back to the start view.
            stage!.classList.add("no-anim");
            setView("search");
            void stage!.offsetWidth;
            stage!.classList.remove("no-anim");
        }

        replay.addEventListener("click", () => {
            replays += 1;
            track("demo_replay_click", {
                location: "hero",
                replay_count: replays,
                seconds_since_complete: Math.round(
                    (Date.now() - completedAt) / 1000,
                ),
                interrupted: pauses > 0,
                reduced_motion: reduceMotion,
            });
            reset();
            play();
        });

        // Start on first 50% visibility; pause while off-screen, resume on return.
        const io = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    inView = entry.isIntersecting;
                    if (entry.isIntersecting) {
                        started = true;
                        play();
                    } else {
                        pause();
                    }
                }
            },
            { threshold: 0.5 },
        );
        io.observe(wrap);

        document.addEventListener("visibilitychange", () => {
            if (document.hidden) pause();
            else if (inView && started) play();
        });
    }
</script>
