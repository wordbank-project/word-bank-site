---
import Logo from "./Logo.astro";
import { getCopy, localeRoot, LANGS, LANG_META, type Lang } from "../i18n";

interface Props {
    lang: Lang;
    /** Set on subpages (e.g. "support"): section links point back to the
        homepage, and the language switcher stays on this page. */
    subpath?: string;
}

const { lang, subpath = "" } = Astro.props;
const t = getCopy(lang);
const home = localeRoot(lang);

const iconClass = "w-[18px] h-[18px]";
---

<header class="nav">
    <div class="mx-auto max-w-270 gap-3 px-6 nav-inner">
        <a
            href={subpath ? home : "#top"}
            class="nav-logo"
            data-scroll-top={subpath ? undefined : true}
            aria-label={t.nav.backToTop}
        >
            <Logo withWordmark />
        </a>

        <div class="flex items-center gap-4">
            <nav class="nav-links" aria-label="Main" data-nav-links>
                {t.nav.links.map(({ href, label }) => <a href={subpath ? `${home}${href}` : href}>{label}</a>)}
                <a
                    href={subpath ? home : "#top"}
                    class="button button-small"
                    data-scroll-top={subpath ? undefined : true}
                    data-ph-event="cta_get_app_click">{t.nav.cta}</a
                >
            </nav>

            <!-- Language dropdown: current language + searchable list of all
                 locales. Lives in the top bar at every width (replaces the old
                 two-way toggle + hamburger item). -->
            <div class="relative" data-lang-dropdown>
                <button
                    type="button"
                    class="inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-full border border-line bg-transparent px-3.5 text-[0.85rem] font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
                    aria-label={t.nav.language.label}
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    data-lang-trigger
                >
                    {/* Full native name on desktop; the compact code on narrow
                        screens so the bar doesn't crowd the wordmark. */}
                    <span class="max-[720px]:hidden">{LANG_META[lang].native}</span>
                    <span class="hidden max-[720px]:inline">{LANG_META[lang].code}</span>
                    <svg
                        class="h-3.5 w-3.5 transition-transform"
                        data-lang-chevron
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m6 9 6 6 6-6"></path>
                    </svg>
                </button>

                {/* Desktop: popover anchored to the pill. Mobile (≤720px): a
                    fixed, centered sheet just below the 64px header bar. */}
                <div
                    class="hidden absolute right-0 top-[calc(100%+8px)] z-50 w-64 rounded-xl border border-line bg-surface p-2 shadow-(--shadow) max-[720px]:fixed max-[720px]:inset-x-4 max-[720px]:top-18 max-[720px]:w-auto"
                    data-lang-panel
                >
                    <div class="relative mb-1">
                        <svg
                            class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-muted"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="m21 21-4.3-4.3"></path>
                        </svg>
                        <input
                            type="text"
                            class="w-full rounded-lg border border-line bg-surface-soft py-2 pl-9 pr-3 text-[0.9rem] text-ink placeholder:text-ink-muted"
                            placeholder={t.nav.language.search}
                            aria-label={t.nav.language.search}
                            data-lang-search
                        />
                    </div>

                    <div class="max-h-72 overflow-y-auto" role="listbox" aria-label={t.nav.language.label}>
                        {LANGS.map((l) => {
                            const meta = LANG_META[l];
                            return (
                                <a
                                    href={localeRoot(l) + subpath}
                                    hreflang={l}
                                    role="option"
                                    aria-selected={l === lang}
                                    aria-current={l === lang ? "true" : undefined}
                                    class="flex items-center justify-between gap-2 rounded-lg px-3 py-2 no-underline transition-colors hover:bg-surface-soft"
                                    data-lang-link
                                    data-base={localeRoot(l) + subpath}
                                    data-lang={l}
                                    data-filter={`${meta.native} ${meta.english} ${meta.code}`.toLowerCase()}
                                >
                                    <span class="flex flex-col">
                                        <span class="text-[0.95rem] font-semibold text-ink">{meta.native}</span>
                                        {meta.english !== meta.native && (
                                            <span class="text-[0.8rem] text-ink-muted">{meta.english}</span>
                                        )}
                                    </span>
                                    {l === lang && <span class="text-sm font-bold text-accent">✓</span>}
                                </a>
                            );
                        })}
                        <p class="px-3 py-2 text-[0.9rem] text-ink-muted" data-lang-empty hidden>
                            {t.nav.language.noResults}
                        </p>
                    </div>
                </div>
            </div>

            <button
                type="button"
                class="inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-[10px] border border-line bg-transparent text-ink transition-colors hover:border-accent hover:text-accent"
                aria-label={`${t.nav.theme.prefix}: ${t.nav.theme.system}`}
                data-theme-toggle
                data-theme-prefix={t.nav.theme.prefix}
                data-theme-light={t.nav.theme.light}
                data-theme-dark={t.nav.theme.dark}
                data-theme-system={t.nav.theme.system}
            >
                <svg
                    class={`${iconClass} hidden`}
                    data-icon="light"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="4"></circle>
                    <path
                        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                    ></path>
                </svg>
                <svg
                    class={`${iconClass} hidden`}
                    data-icon="dark"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"
                    ></path>
                </svg>
                <svg
                    class={iconClass}
                    data-icon="system"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <rect x="3" y="4" width="18" height="13" rx="2"></rect>
                    <path d="M8 21h8M12 17v4"></path>
                </svg>
            </button>

            <button
                type="button"
                class="nav-toggle"
                aria-expanded="false"
                aria-label={t.nav.openMenu}
                data-nav-toggle
                data-open-label={t.nav.openMenu}
                data-close-label={t.nav.closeMenu}>☰</button
            >
        </div>
    </div>
</header>

<script>
    import { track } from "../lib/analytics";

    // --- Mobile menu ---------------------------------------------------------
    const navToggle =
        document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const links = document.querySelector<HTMLElement>("[data-nav-links]");

    const openLabel = navToggle?.dataset.openLabel ?? "Open menu";
    const closeLabel = navToggle?.dataset.closeLabel ?? "Close menu";

    const closeMenu = () => {
        if (!navToggle || !links) return;
        links.classList.remove("open");
        navToggle.setAttribute("aria-expanded", "false");
        navToggle.setAttribute("aria-label", openLabel);
        navToggle.textContent = "☰";
    };

    if (navToggle && links) {
        navToggle.addEventListener("click", () => {
            const open = links.classList.toggle("open");
            navToggle.setAttribute("aria-expanded", String(open));
            navToggle.setAttribute("aria-label", open ? closeLabel : openLabel);
            navToggle.textContent = open ? "✕" : "☰";
        });
        links
            .querySelectorAll("a")
            .forEach((a) => a.addEventListener("click", closeMenu));
        // Clicking anywhere outside the open menu (and not on the toggle,
        // which handles its own click) closes it — the CSS transition makes
        // it fade/slide out smoothly.
        document.addEventListener("click", (e) => {
            if (
                links.classList.contains("open") &&
                !links.contains(e.target as Node) &&
                !navToggle.contains(e.target as Node)
            ) {
                closeMenu();
            }
        });
    }

    // --- Language links: keep the current #section when switching locale, and
    //     remember the choice so return visits land in the same language (the
    //     pre-paint script in Layout.astro reads localStorage "lang"). Each row
    //     carries its locale in data-lang, so this needs no per-language code. ----
    const langLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-lang-link]"),
    );
    const syncLangHref = () =>
        langLinks.forEach((l) => {
            l.href = (l.dataset.base ?? "/") + location.hash;
        });
    if (langLinks.length) {
        syncLangHref();
        window.addEventListener("hashchange", syncLangHref);
        langLinks.forEach((l) =>
            l.addEventListener("click", () => {
                // Refresh the href with the live hash right before navigation,
                // in case a sync was ever missed (belt-and-suspenders).
                l.href = (l.dataset.base ?? "/") + location.hash;
                track("language_change", {
                    from: document.documentElement.lang,
                    to: l.dataset.lang,
                });
                try {
                    if (l.dataset.lang) localStorage.setItem("lang", l.dataset.lang);
                } catch {
                    /* ignore */
                }
            }),
        );
    }

    // --- Language dropdown: open/close, search filter, outside-click/Esc ------
    const dropdown = document.querySelector<HTMLElement>("[data-lang-dropdown]");
    if (dropdown) {
        const trigger = dropdown.querySelector<HTMLButtonElement>("[data-lang-trigger]")!;
        const panel = dropdown.querySelector<HTMLElement>("[data-lang-panel]")!;
        const search = dropdown.querySelector<HTMLInputElement>("[data-lang-search]")!;
        const chevron = dropdown.querySelector<SVGElement>("[data-lang-chevron]");
        const rows = Array.from(
            dropdown.querySelectorAll<HTMLAnchorElement>("[data-lang-link]"),
        );
        const empty = dropdown.querySelector<HTMLElement>("[data-lang-empty]");

        const applyFilter = () => {
            const q = search.value.trim().toLowerCase();
            let anyVisible = false;
            rows.forEach((row) => {
                const match = !q || (row.dataset.filter ?? "").includes(q);
                row.toggleAttribute("hidden", !match);
                if (match) anyVisible = true;
            });
            empty?.toggleAttribute("hidden", anyVisible);
        };

        const isOpen = () => !panel.classList.contains("hidden");
        const setOpen = (open: boolean) => {
            panel.classList.toggle("hidden", !open);
            trigger.setAttribute("aria-expanded", String(open));
            chevron?.classList.toggle("rotate-180", open);
            if (open) {
                search.value = "";
                applyFilter();
                search.focus();
            }
        };

        trigger.addEventListener("click", () => setOpen(!isOpen()));
        search.addEventListener("input", applyFilter);
        document.addEventListener("click", (e) => {
            if (isOpen() && !dropdown.contains(e.target as Node)) setOpen(false);
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && isOpen()) {
                setOpen(false);
                trigger.focus();
            }
        });
    }

    // --- Theme toggle: light → dark → system, persisted in localStorage ------
    type Pref = "light" | "dark" | "system";
    const ORDER: Pref[] = ["light", "dark", "system"];
    const themeBtn = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
    );
    const mql = window.matchMedia("(prefers-color-scheme: dark)");

    const getPref = (): Pref => {
        const v = localStorage.getItem("theme");
        return v === "light" || v === "dark" || v === "system" ? v : "system";
    };
    const resolve = (pref: Pref): "dark" | "light" =>
        pref === "dark" || (pref === "system" && mql.matches)
            ? "dark"
            : "light";

    const apply = (pref: Pref) => {
        document.documentElement.dataset.theme = resolve(pref);
        if (!themeBtn) return;
        themeBtn
            .querySelectorAll<SVGElement>("[data-icon]")
            .forEach((el) =>
                el.classList.toggle("hidden", el.dataset.icon !== pref),
            );
        const prefix = themeBtn.dataset.themePrefix ?? "Theme";
        const names: Record<Pref, string> = {
            light: themeBtn.dataset.themeLight ?? "light",
            dark: themeBtn.dataset.themeDark ?? "dark",
            system: themeBtn.dataset.themeSystem ?? "system",
        };
        themeBtn.setAttribute("aria-label", `${prefix}: ${names[pref]}`);
    };

    if (themeBtn) {
        apply(getPref());
        themeBtn.addEventListener("click", () => {
            const next = ORDER[(ORDER.indexOf(getPref()) + 1) % ORDER.length];
            track("theme_change", { theme: next });
            try {
                localStorage.setItem("theme", next);
            } catch {
                /* ignore */
            }
            apply(next);
        });
        mql.addEventListener("change", () => {
            if (getPref() === "system") apply("system");
        });
    }

    // --- Scroll to top: the logo and the "Get the app" button. Works on mobile
    //     too, and closes the open nav menu first. Falls back to the #top anchor
    //     when JS is off. Honors reduced-motion.
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;
    document
        .querySelectorAll<HTMLAnchorElement>("[data-scroll-top]")
        .forEach((el) =>
            el.addEventListener("click", (e) => {
                e.preventDefault();
                closeMenu();
                window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
                // Drop the section hash so the URL reflects the top of the page
                // (just / or /nl/) — otherwise switching language would jump back
                // to the last-visited section.
                if (location.hash) {
                    history.replaceState(null, "", location.pathname + location.search);
                    syncLangHref();
                }
            }),
        );

    // --- Lift the sticky bar off the content once the page scrolls -----------
    const nav = document.querySelector<HTMLElement>(".nav");
    if (nav) {
        const onScroll = () =>
            nav.classList.toggle("scrolled", window.scrollY > 8);
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
    }

    // --- Scroll-spy: mark the nav link of the section in view ----------------
    //     (aria-current="true" — styled accent in global.css). The observer
    //     band sits around the upper-middle of the viewport so the highlight
    //     flips roughly when a section's content dominates the screen.
    const spyLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(
            '[data-nav-links] a[href^="#"]:not([data-scroll-top])',
        ),
    );
    const spyTargets = spyLinks
        .map((a) => document.querySelector<HTMLElement>(a.hash))
        .filter((el): el is HTMLElement => el !== null);
    if (spyTargets.length && "IntersectionObserver" in window) {
        // On a fresh load with a #fragment (e.g. arriving from a language
        // switch), jump there instantly BEFORE registering the observers.
        // Module scripts run before the browser's own fragment scroll, so the
        // hero observer would otherwise fire with the still-at-top viewport
        // and strip the hash via replaceState — losing the target. "instant"
        // also sidesteps the css smooth-scroll race. scrollIntoView honours
        // the sections' scroll-margin-top, so they land below the sticky bar.
        const initialTarget = location.hash
            ? document.querySelector<HTMLElement>(location.hash)
            : null;
        initialTarget?.scrollIntoView({ behavior: "instant", block: "start" });

        const setActive = (id: string | null) => {
            spyLinks.forEach((a) => {
                if (a.hash === `#${id}`) a.setAttribute("aria-current", "true");
                else a.removeAttribute("aria-current");
            });
            // Mirror the active section into the URL (replace, not push — no
            // history spam, no scroll side-effects) so the language switcher
            // and copied links reflect where the visitor actually is.
            // replaceState doesn't fire hashchange → re-sync the lang links.
            const nextHash = id ? `#${id}` : "";
            if (location.hash !== nextHash) {
                // Fire once per real section change (not for the hero/null case).
                if (id) track("section_view", { section: id });
                history.replaceState(
                    null,
                    "",
                    nextHash || location.pathname + location.search,
                );
                syncLangHref();
            }
        };
        const spy = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) setActive(entry.target.id);
                }
            },
            { rootMargin: "-20% 0px -70% 0px" },
        );
        spyTargets.forEach((el) => spy.observe(el));
        // Above the first section (hero) nothing should be highlighted.
        const hero = document.getElementById("top");
        if (hero) {
            new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) setActive(null);
                    }
                },
                { rootMargin: "-20% 0px -70% 0px" },
            ).observe(hero);
        }
    }
</script>
