---
import { getCopy, type Lang } from "../i18n";
import Section from "./Section.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = getCopy(lang);
---

<Section id="faq">
    <h2>{t.faq.heading}</h2>
    {/* mt-12 mirrors `.section-sub`'s 48px — this section has no sub-line, so
        without it the heading sits far tighter than in every other section. */}
    <div class="mx-auto mt-12 flex max-w-170 flex-col gap-3" data-stagger>
        {
            t.faq.items.map(({ question, answer }) => (
                <details class="faq-item">
                    <summary>{question}</summary>
                    <p>{answer}</p>
                </details>
            ))
        }
    </div>
</Section>

<script>
    import { track } from "../lib/analytics";

    // Track which questions readers open (only on open — the toggle event also
    // fires on close, which we ignore).
    document
        .querySelectorAll<HTMLDetailsElement>("details.faq-item")
        .forEach((details) => {
            details.addEventListener("toggle", () => {
                if (!details.open) return;
                track("faq_open", {
                    question: details.querySelector("summary")?.textContent?.trim(),
                });
            });
        });
</script>
